# copy to ios/signing.local.env (gitignored) and fill in; read by scripts/sign-ios.sh, install-ios.sh and spike/memtest
#
# the 10-character team id of the Apple account that signs (Xcode > Settings > Accounts, or developer.apple.com > Membership)
TEAM=XXXXXXXXXX
# the app's id: unique to you, and the same as the App ID of the provisioning profile
BUNDLE_ID=com.example.black
# the signing identity in your keychain: security find-identity -v -p codesigning
IDENTITY="Apple Distribution: Your Name (XXXXXXXXXX)"
# the provisioning profile for BUNDLE_ID and your device (Ad Hoc, or a development one)
PROFILE=ios/profiles/black.mobileprovision
# the device's UDID or name, for install-ios.sh: xcrun devicectl list devices
DEVICE=00000000-0000000000000000
# 1 when the profile grants com.apple.developer.kernel.increased-memory-limit (paid accounts), else 0: a free Apple ID's
# profile does not, and the app then runs with the memory limit iOS gives every app
INCREASED_MEMORY_LIMIT=1
